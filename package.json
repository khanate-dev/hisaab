{
	"name": "hisaab",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"format": "prettier --write --log-level warn .",
		"format:check": "prettier --check .",
		"spellcheck": "cspell --quiet --no-progress .",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm spellcheck && pnpm test"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/estree": "catalog:",
		"@types/node": "catalog:",
		"cspell": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-react-hooks": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@10.34.7"
}
