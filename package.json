{
	"name": "hisaab",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"test:sync": "pnpm --filter @hisaab/sync-tests test",
		"format": "prettier --write --log-level warn .",
		"format:check": "prettier --check .",
		"spellcheck": "cspell --quiet --no-progress .",
		"stack:up": "tooling/stack/up.sh",
		"stack:down": "tooling/stack/down.sh",
		"test:db": "supabase test db",
		"check:functions": "tooling/stack/functions-check.sh",
		"test:functions": "tooling/stack/functions-smoke.sh",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm spellcheck && pnpm test && pnpm test:app",
		"test:app": "pnpm --filter @hisaab/app test"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/estree": "catalog:",
		"@types/node": "catalog:",
		"cspell": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-lingui": "catalog:",
		"eslint-plugin-react-hooks": "catalog:",
		"globals": "catalog:",
		"powersync": "catalog:",
		"prettier": "catalog:",
		"supabase": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@10.34.7"
}
