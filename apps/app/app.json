{
	"expo": {
		"name": "Hisaab",
		"slug": "hisaab",
		"scheme": "hisaab",
		"version": "0.0.0",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "pk.khanate.hisaab"
		},
		"android": {
			"package": "pk.khanate.hisaab"
		},
		"web": {
			"bundler": "metro",
			"output": "single"
		},
		"plugins": [
			"expo-router",
			[
				"expo-local-authentication",
				{
					"faceIDPermission": "Hisaab uses Face ID to unlock the app, if you turn the app lock on."
				}
			],
			"expo-notifications"
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
