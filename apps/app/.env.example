# Copy to apps/app/.env.local (gitignored) to point the app at the local stack from `pnpm stack:up`.
# These are the Supabase CLI's fixed local-dev values, not secrets; `pnpm exec supabase status` is the source of truth. On a physical device, swap localhost for your LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:55380
# The web app's address, for Invite links that open in any browser.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# Web Push's VAPID public key (the private one is an Edge Function secret); leave empty to not offer web push.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
