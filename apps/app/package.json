{
	"name": "@hisaab/app",
	"private": true,
	"main": "expo-router/entry",
	"exports": {
		"./connector": "./src/lib/powersync/connector.ts"
	},
	"scripts": {
		"start": "expo start",
		"web": "pnpm prepare:web && expo start --web",
		"android": "expo run:android",
		"prepare:web": "powersync-web copy-assets --output public",
		"typecheck": "tsc -p tsconfig.json",
		"test": "jest",
		"i18n:extract": "lingui extract --clean",
		"i18n:compile": "lingui compile --typescript"
	},
	"dependencies": {
		"@azure/core-asynciterator-polyfill": "catalog:",
		"@expo-google-fonts/archivo-black": "catalog:",
		"@expo-google-fonts/space-grotesk": "catalog:",
		"@expo/metro-runtime": "catalog:",
		"@hisaab/client-schema": "workspace:*",
		"@hisaab/domain": "workspace:*",
		"@lingui/core": "catalog:",
		"@lingui/react": "catalog:",
		"@op-engineering/op-sqlite": "catalog:",
		"@powersync/common": "catalog:",
		"@powersync/drizzle-driver": "catalog:",
		"@powersync/react": "catalog:",
		"@powersync/react-native": "catalog:",
		"@powersync/web": "catalog:",
		"@react-native-async-storage/async-storage": "catalog:",
		"@rn-primitives/dialog": "catalog:",
		"@rn-primitives/portal": "catalog:",
		"@supabase/supabase-js": "catalog:",
		"drizzle-orm": "catalog:",
		"expo": "catalog:",
		"expo-constants": "catalog:",
		"expo-dev-client": "catalog:",
		"expo-font": "catalog:",
		"expo-linking": "catalog:",
		"expo-router": "catalog:",
		"expo-status-bar": "catalog:",
		"lucide-react-native": "catalog:",
		"nativewind": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-native": "catalog:",
		"react-native-css-interop": "catalog:",
		"react-native-reanimated": "catalog:",
		"react-native-safe-area-context": "catalog:",
		"react-native-screens": "catalog:",
		"react-native-svg": "catalog:",
		"react-native-url-polyfill": "catalog:",
		"react-native-web": "catalog:",
		"react-native-worklets": "catalog:"
	},
	"devDependencies": {
		"@jest/globals": "catalog:",
		"@lingui/babel-plugin-lingui-macro": "catalog:",
		"@lingui/cli": "catalog:",
		"@react-native/metro-config": "catalog:",
		"@testing-library/react-native": "catalog:",
		"@types/react": "catalog:",
		"babel-preset-expo": "catalog:",
		"jest": "catalog:",
		"jest-expo": "catalog:",
		"tailwindcss": "catalog:",
		"test-renderer": "catalog:",
		"typescript": "catalog:"
	},
	"jest": {
		"testTimeout": 20000,
		"projects": [
			{
				"displayName": "ios",
				"preset": "jest-expo/ios",
				"transformIgnorePatterns": [
					"/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@powersync|drizzle-orm|@rn-primitives|lucide-react-native|nativewind|react-native-css-interop|react-native-svg|@lingui|@messageformat))",
					"/node_modules/react-native-reanimated/plugin/",
					"/node_modules/@react-native/babel-preset/"
				],
				"moduleNameMapper": {
					"^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
				},
				"transform": {
					"\\.mjs$": "babel-jest"
				}
			},
			{
				"displayName": "android",
				"preset": "jest-expo/android",
				"transformIgnorePatterns": [
					"/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@powersync|drizzle-orm|@rn-primitives|lucide-react-native|nativewind|react-native-css-interop|react-native-svg|@lingui|@messageformat))",
					"/node_modules/react-native-reanimated/plugin/",
					"/node_modules/@react-native/babel-preset/"
				],
				"moduleNameMapper": {
					"^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
				},
				"transform": {
					"\\.mjs$": "babel-jest"
				}
			}
		]
	}
}
